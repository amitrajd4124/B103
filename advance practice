# 36. Copy only the even-numbered lines from one file to another.
try:
    with open("sample.txt", "w") as f:
        f.write("Line one\nLine two\nLine three\nLine four\n")
    
    lines = words = chars = 0
    with open("sample.txt", "r") as file:
        for line in file:
            lines += 1
            words += len(line.split())
            chars += len(line)
    print(f"File Stats (Q35) -> Lines: {lines}, Words: {words}, Chars: {chars}")
    
    with open("sample.txt", "r") as src, open("output.txt", "w") as dest:
        for line_num, line in enumerate(src, start=1):
            if line_num % 2 == 0:
                dest.write(line)
    print("Even-numbered lines copied successfully (Q36).")
except Exception as e:
    print("File operation error:", e)

