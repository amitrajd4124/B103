# 19. Write a function to check if a string is a palindrome.
def is_string_palindrome(s):
    cleaned = s.lower().replace(" ", "")
    return cleaned == cleaned[::-1]

print("Is 'madam' palindrome?", is_string_palindrome("madam"))


# 20. Write a function to count vowels and consonants in a string.
def count_vowels_consonants(s):
    vowels = "aeiouAEIOU"
    v_count = c_count = 0
    for ch in s:
        if ch.isalpha():
            if ch in vowels:
                v_count += 1
            else:
                c_count += 1
    return v_count, c_count

v, c = count_vowels_consonants("Hello World")
print("Vowels:", v, "Consonants:", c)


# 21. Create a function to calculate simple and compound interest.
def calculate_interest(p, r, t):
    si = (p * r * t) / 100
    ci = p * ((1 + r / 100) ** t) - p
    return si, ci

si, ci = calculate_interest(1000, 5, 2)
print("SI:", si, "| CI:", round(ci, 2))


# 22. Write a function to return all factors of a number.
def get_factors(n):
    return [i for i in range(1, n + 1) if n % i == 0]

print("Factors of 12:", get_factors(12))


# 23. Write a function to find the second-largest number in a list.
def second_largest(lst):
    unique = list(set(lst))
    unique.sort()
    return unique[-2] if len(unique) >= 2 else None

