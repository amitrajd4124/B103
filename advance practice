# 16. Check whether a number is an Armstrong number.
num = 153
temp = num
digits = len(str(num))
total_sum = 0

while temp > 0:
    d = temp % 10
    total_sum += d ** digits
    temp //= 10

if total_sum == num:
    print(num, "is an Armstrong number")


